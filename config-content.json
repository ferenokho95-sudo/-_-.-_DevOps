{
  "db-config": {
    "filename": "db-config.json",
    "content": "{\"type\": \"mariadb\", \"hostname\": \"db\", \"port\": 3306, \"username\": \"kuma\", \"password\": \"${DB_PASSWORD:?required}\", \"dbName\": \"kuma\"}"
  },
  "exporter-init": {
    "filename": "exporter.sql",
    "content": "CREATE USER IF NOT EXISTS 'exporter'@'%' IDENTIFIED BY '${EXPORTER_PASSWORD:?required}' WITH MAX_USER_CONNECTIONS 3;\nGRANT PROCESS, REPLICATION CLIENT, SELECT ON *.* TO 'exporter'@'%';\n"
  },
  "prometheus": {
    "filename": "prometheus.yml",
    "content": "{\"global\": {\"scrape_interval\": \"5s\", \"evaluation_interval\": \"5s\"}, \"scrape_configs\": [{\"job_name\": \"prometheus\", \"static_configs\": [{\"targets\": [\"prometheus:9090\"]}]}, {\"job_name\": \"node\", \"static_configs\": [{\"targets\": [\"node:9100\"]}]}, {\"job_name\": \"cadvisor\", \"static_configs\": [{\"targets\": [\"cadvisor:8080\"]}]}, {\"job_name\": \"mariadb\", \"static_configs\": [{\"targets\": [\"mysqld:9104\"]}]}, {\"job_name\": \"http\", \"metrics_path\": \"/probe\", \"params\": {\"module\": [\"http_2xx\"]}, \"static_configs\": [{\"targets\": [\"http://kuma:3001\", \"http://grafana:3000/api/health\"]}], \"relabel_configs\": [{\"source_labels\": [\"__address__\"], \"target_label\": \"__param_target\"}, {\"source_labels\": [\"__param_target\"], \"target_label\": \"instance\"}, {\"target_label\": \"__address__\", \"replacement\": \"blackbox:9115\"}]}]}"
  },
  "blackbox": {
    "filename": "blackbox.yml",
    "content": "{\"modules\": {\"http_2xx\": {\"prober\": \"http\", \"timeout\": \"3s\", \"http\": {\"preferred_ip_protocol\": \"ip4\", \"follow_redirects\": true}}}}"
  },
  "mysql": {
    "filename": "mysql.cnf",
    "content": "[client]\nhost=db\nuser=exporter\npassword=${EXPORTER_PASSWORD:?required}\n"
  }
}
